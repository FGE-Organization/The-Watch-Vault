@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var returnPath = string.IsNullOrEmpty(path) ? "/" : (path.StartsWith("/") ? path : "/" + path);
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnPath)}", true);
    }
}
